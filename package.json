{
  "name": "talent-graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Talent Graph algorithm core and longitudinal evidence pipeline.",
  "module": "src/index.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "demo": "bun run scripts/demo.ts",
    "club:web": "doppler run -- bun --cwd apps/club dev",
