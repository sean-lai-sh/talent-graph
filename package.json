    "drift": "bun run scripts/drift.ts",
    "club:convex": "doppler run -- bun --cwd apps/club convex:dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
