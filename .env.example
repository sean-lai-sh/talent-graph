# Tunables for the Talent Graph algorithm core (PLAN.md §10).
# All are optional: src/config.ts has hard-coded defaults identical to these.
# The example admin (apps/club) deploys with none of these set. Do not add
# Clerk or other auth keys — `/` and `/example` stay public.
# Doppler project `talent-graph`, config `dev` holds the same keys, so both
# `doppler run --project talent-graph --config dev -- bun test` and plain
# `bun test` work.

# Bradley-Terry L2 regularization strength (lambda).
TG_BT_REGULARIZATION=0.1
# Maximum solver iterations before giving up on the tolerance check.
TG_BT_MAX_ITERATIONS=500
# Convergence tolerance on the infinity norm of the gradient.
TG_BT_TOLERANCE=1e-6
# Minimum comparisons on a dimension before a capability estimate is reported.
TG_MIN_COMPARISONS=3
# Minimum distinct opponents on a dimension before an estimate is reported.
TG_MIN_OPPONENTS=2
# Number of strongest incoming referrals averaged into the Referral Signal.
TG_TOP_K_REFERRALS=5
